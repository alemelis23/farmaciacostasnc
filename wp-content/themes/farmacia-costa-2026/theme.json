{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "72rem",
			"wideSize": "84rem"
		},
		"color": {
			"defaultPalettes": false,
			"defaultGradients": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "avorio", "color": "#F8F4EC", "name": "Avorio" },
				{ "slug": "bianco", "color": "#FFFFFF", "name": "Bianco" },
				{ "slug": "grafite", "color": "#26312C", "name": "Grafite" },
				{ "slug": "verde-bosco", "color": "#14524A", "name": "Verde bosco" },
				{ "slug": "verde-profondo", "color": "#0C332E", "name": "Verde profondo" },
				{ "slug": "salvia", "color": "#7FA08F", "name": "Salvia" },
				{ "slug": "salvia-chiara", "color": "#E3ECE3", "name": "Salvia chiara" },
				{ "slug": "terracotta", "color": "#A8481F", "name": "Terracotta" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "titoli",
					"name": "Fraunces (titoli)",
					"fontFamily": "\"Fraunces\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontWeight": "300 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fraunces-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "testo",
					"name": "Inter (testo)",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9375rem", "name": "Piccolo", "fluid": false },
				{ "slug": "medium", "size": "1.0625rem", "name": "Testo", "fluid": false },
				{ "slug": "large", "size": "1.375rem", "name": "Grande", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "size": "1.875rem", "name": "Titolo", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "size": "2.75rem", "name": "Titolo grande", "fluid": { "min": "2.125rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "XS" },
				{ "slug": "30", "size": "1rem", "name": "S" },
				{ "slug": "40", "size": "1.5rem", "name": "M" },
				{ "slug": "50", "size": "clamp(2rem, 4vw, 3rem)", "name": "L" },
				{ "slug": "60", "size": "clamp(3rem, 6vw, 4.5rem)", "name": "XL" },
				{ "slug": "70", "size": "clamp(4rem, 8vw, 6.5rem)", "name": "XXL" }
			]
		},
		"custom": {
			"radius": {
				"s": "0.5rem",
				"m": "1rem",
				"l": "1.5rem"
			},
			"shadow": {
				"card": "0 1px 2px rgba(12, 51, 46, 0.06), 0 8px 24px rgba(12, 51, 46, 0.08)",
				"lift": "0 2px 4px rgba(12, 51, 46, 0.08), 0 16px 40px rgba(12, 51, 46, 0.14)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--avorio)",
			"text": "var(--wp--preset--color--grafite)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--testo)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titoli)",
					"fontWeight": "560",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--verde-profondo)"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--verde-bosco)" },
				":hover": { "color": { "text": "var(--wp--preset--color--verde-profondo)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--verde-bosco)",
					"text": "var(--wp--preset--color--bianco)"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--verde-profondo)",
						"text": "var(--wp--preset--color--bianco)"
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-contattaci", "title": "Pagina contatti", "postTypes": [ "page" ] },
		{ "name": "page-chi-siamo", "title": "Pagina chi siamo", "postTypes": [ "page" ] },
		{ "name": "page-ricetta-in-farmacia", "title": "Pagina ricetta in farmacia", "postTypes": [ "page" ] },
		{ "name": "page-lavora-con-noi", "title": "Pagina lavora con noi", "postTypes": [ "page" ] }
	]
}
